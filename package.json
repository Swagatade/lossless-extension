{
  "name": "lossless-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted lossless FLAC audio addon for Echo Music with multi-provider streaming support.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/EchoMusicApp/lossless-extension.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test test/**/*.test.ts",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  }
}
